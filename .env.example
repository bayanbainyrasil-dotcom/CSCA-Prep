# Deployment contract. Use local-demo only for local work and the GitHub Pages
# demonstration. Every Vercel environment must use firebase.
VITE_DEPLOYMENT_MODE=local-demo

# Firebase web app configuration (Firebase console > Project settings > Your apps).
# These client identifiers are not service-account secrets, but production access must
# still be protected by Security Rules, App Check, and restricted API-key settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional in local development; required by production builds because callable
# Functions enforce App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local development only. Redirects Auth, Firestore, Storage, and callable
# Functions to the ports declared in firebase.json.
VITE_USE_FIREBASE_EMULATORS=false
