{
  "name": "csca-prep-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted Firebase backend for CSCA Prep",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "serve": "npm run build && firebase emulators:start --only auth,firestore,functions,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "firebase-tools": "^15.30.0",
    "typescript": "^7.0.2"
  }
}
